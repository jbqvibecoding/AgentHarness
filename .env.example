# Agent LLM (any OpenAI-compatible /v1 endpoint)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Judge LLM (the model is pinned per benchmark in benchmarks/judges/)
JUDGE_API_KEY=
JUDGE_BASE_URL=

# Search
SERPER_API_KEY=

# Web fetch
JINA_API_KEY=

SUMMARY_LLM_API_KEY=
SUMMARY_LLM_BASE_URL=
SUMMARY_LLM_MODEL_NAME=

# Code sandbox
E2B_API_KEY=

# Model council members (deep_council_research / model_council pipelines).
# Each slot is one member model; empty slots are skipped and at least 2
# members are required. BASE_URL/API_KEY fall back to OPENAI_* when empty;
# NAME falls back to the model id. COUNCIL_SYNTH_MODEL is the
# analyst/synthesizer (falls back to OPENAI_MODEL).
COUNCIL_NAME_1=
COUNCIL_MODEL_1=
COUNCIL_BASE_URL_1=
COUNCIL_API_KEY_1=
COUNCIL_NAME_2=
COUNCIL_MODEL_2=
COUNCIL_BASE_URL_2=
COUNCIL_API_KEY_2=
COUNCIL_NAME_3=
COUNCIL_MODEL_3=
COUNCIL_BASE_URL_3=
COUNCIL_API_KEY_3=
COUNCIL_SYNTH_MODEL=

